# App
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000

# Database — local Docker example:
#   docker run --name patients-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=patients -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/patients

# Vapi signs tool-call and end-of-call webhooks with this secret.
# Create a Bearer Token Custom Credential in Vapi whose header is X-Vapi-Secret
# (Bearer prefix OFF) and paste the same value here.
VAPI_WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Used only by scripts/provision_vapi.py to create/update the assistant + tools.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# OpenAI is selected inside the Vapi dashboard (Vapi bills the LLM).
# Keep a key here only if you want to experiment with the prompt locally.
OPENAI_API_KEY=

# Optional: public HTTPS origin used in provision_vapi.py (Render URL or ngrok).
PUBLIC_BASE_URL=https://your-app.onrender.com
